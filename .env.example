# ============================================================
# Discord Bot 設定ファイル
# このファイルを .env にコピーして値を設定してください
# ============================================================
#
# ローカルテスト:
#   本番Botと別のBotアプリケーションを作成し、テスト用のトークン・
#   クライアントIDを使用してください。テスト用Botは開発専用サーバー
#   にのみ招待し、本番環境と干渉しないようにします。
#   DISCORD_GUILD_ID を設定するとコマンドが即時反映されます。
#
# ============================================================

# ------------------------------------------------------------
# 必須設定（これらは必ず設定してください）
# ------------------------------------------------------------

# Discord Botトークン（Discord Developer Portalから取得）
# ローカルテスト時はテスト用Botのトークンを使用
DISCORD_TOKEN=your_discord_bot_token

# DiscordアプリケーションのクライアントID
# ローカルテスト時はテスト用BotのクライアントIDを使用
DISCORD_CLIENT_ID=your_discord_client_id

# ------------------------------------------------------------
# 基本設定（必要に応じて変更）
# ------------------------------------------------------------

# Bot管理者のDiscord ID（カンマ区切りで複数指定可）
# NODE_ENV=production のときは必須（未設定だと起動時にエラー）/owner コマンド用
BOT_OWNER_IDS=your_discord_user_id

# 環境モード: development（開発）/ production（本番）
NODE_ENV=development

# タイムゾーン（バックアップの実行時刻やログの時刻に使用）
TZ=Asia/Tokyo

# VC統計（/notification stats）で1日を区切るタイムゾーン（IANA形式）
# 未設定なら TZ、TZ も未設定なら Asia/Tokyo。存在しないゾーン名を指定すると起動時にエラーになります
# STATS_TIMEZONE=Asia/Tokyo

# 開発用: コマンド即時反映用のサーバーID（本番では空のまま）
# DISCORD_GUILD_ID=

# スラッシュコマンドを起動時に必ず再登録する（true のときだけ）
# 通常は前回登録した内容（DATA_DIR/command-sync.json）と同じなら登録を省略します。
# Bot の外でコマンドを変更・削除した後（npm run cleanup-commands など）に一度だけ使ってください
# FORCE_COMMAND_SYNC=true

# ------------------------------------------------------------
# 読み上げ / VOICEVOX（任意）
# ------------------------------------------------------------

# VOICEVOX ENGINE の URL。設定すると /tts（チャットの読み上げ）が有効になります。
# 設定すると Bot は Message Content Intent を要求するため、Developer Portal の
# Bot → Privileged Gateway Intents → MESSAGE CONTENT INTENT を必ずオンにしてください
# （オフのままだと Discord がログインを拒否し、Bot が起動しません）。
# Railway で同じプロジェクトに VOICEVOX を立てた場合の例:
# VOICEVOX_URL=http://voicevox.railway.internal:50021
# ローカルで docker run -p 50021:50021 voicevox/voicevox_engine:cpu-latest した場合:
# VOICEVOX_URL=http://localhost:50021

# ------------------------------------------------------------
# アラート通知（任意）
# ------------------------------------------------------------

# システムアラート用Discord Webhook URL
# サーバー設定 → 連携サービス → Webhook から作成
# unhandledRejection / uncaughtException / メモリ閾値超過時に通知
# HTTPS URL のみ許可されます
# ALERT_WEBHOOK_URL=https://discord.com/api/webhooks/xxx/yyy

# ログレベル: debug | info | warn | error
# 未設定時: 本番は info、開発は debug
# LOG_LEVEL=info

# ------------------------------------------------------------
# 運用チューニング（通常は変更不要）
# ------------------------------------------------------------

# 音声録音の最大時間（秒、デフォルト: 300 = 5分）
# MAX_RECORDING_DURATION=300

# 音声バッファの保持時間（秒、デフォルト: 300 = 5分）
# 全量メモリ上のリングバッファです。1チャンネルあたり約 0.27MB/秒
# （デフォルトで約82MB）を消費します。確保は「最初に音声が届いた時点」なので、
# 誰も話さないチャンネルに接続しているだけならメモリは消費しません。
# MAX_RECORDING_DURATION を超える値を設定しても録音できる長さは伸びず、
# メモリだけ増えます。
# AUDIO_BUFFER_DURATION=300

# プロセスのメモリ上限の目安（MB、デフォルト: 512、範囲: 128〜8192）
# RSS がこの70%で警告、85%で古いVC接続を切断します。
# ホストが実際に割り当てているメモリ量に合わせてください。
# MEMORY_LIMIT_MB=512

# 同時接続可能なボイスチャンネル数（デフォルト: 5）
# MAX_CONCURRENT_VC_CONNECTIONS=5

# 録音ファイル保持時間（時間、デフォルト: 24）
# RECORDING_RETENTION_HOURS=24

# VCセッション履歴の保持日数（デフォルト: 30日）
# VOICE_SESSION_RETENTION_DAYS=30

# 監査ログの保持日数（デフォルト: 90日）
# AUDIT_LOG_RETENTION_DAYS=90

# バックアップ保持日数（デフォルト: 7日）
# BACKUP_RETENTION_DAYS=7

# バックアップ実行時刻（cron形式、TZ の時刻で解釈、デフォルト: 毎日4時）
# TZ を設定しない Railway では UTC になります（0 4 * * * は日本時間13時）
# 例: 0 4 * * * = 毎日4:00, 0 */6 * * * = 6時間ごと
# BACKUP_CRON=0 4 * * *

# シャットダウン時に最終バックアップを実行（デフォルト: true）
# SHUTDOWN_FINAL_BACKUP=true

# シャットダウンタイムアウト（ミリ秒、デフォルト: 10000、範囲: 5000-120000）
# SHUTDOWN_TIMEOUT_MS=10000

# ------------------------------------------------------------
# パス設定（通常は変更不要）
# ------------------------------------------------------------
#
# Railway Volume を /app/data にマウントする場合、以下はデフォルトのまま変更不要です。
# Nixpacks がアプリを /app 配下に配置するため、相対パス data/ がそのまま Volume を指します。
# すべてのパス設定はリポジトリルート配下の相対パスのみ許可されます。
# 絶対パスや ../ を含む設定は起動時エラーになります。

# データディレクトリ（デフォルト: data/）
# 本番ではコンパイルキャッシュ（.node-compile-cache）とコマンド登録の記録
# （command-sync.json）もここに保存し、再起動を速くします
# DATA_DIR=data/

# データベースファイルパス（デフォルト: data/bot.db）
# DATABASE_PATH=data/bot.db

# 録音ファイル保存先（デフォルト: data/recordings/）
# RECORDINGS_DIR=data/recordings/

# バックアップ保存先（デフォルト: data/backups/）
# BACKUP_DIR=data/backups/

# ------------------------------------------------------------
# NOTE: 以下の技術的な内部定数は環境変数ではなく
# src/config/constants.ts でコード内定数として管理しています：
#   - AUDIO_SAMPLE_RATE, AUDIO_BIT_DEPTH, AUDIO_CHANNELS
#   - DISCORD_MAX_FILE_SIZE
#   - RECORDING_RETRY_MAX
#   - MEMORY_MONITOR_INTERVAL_MS
# メモリ閾値は MEMORY_LIMIT_MB から算出されます（警告70% / 切断85%）。
# ------------------------------------------------------------
