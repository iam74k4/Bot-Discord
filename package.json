{
  "name": "discord-bot",
  "version": "1.0.0",
  "description": "A modular Discord bot built with TypeScript and discord.js",
  "main": "dist/index.js",
  "type": "module",
  "packageManager": "npm@10.9.3",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc",
    "start": "node dist/index.js",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write \"src/**/*.ts\" \"docs/**/*.md\" \"README.md\" \"CONTRIBUTING.md\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"docs/**/*.md\" \"README.md\" \"CONTRIBUTING.md\"",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "cleanup-commands": "tsx src/app-scripts/cleanup-commands.ts",
    "audit:all": "bash scripts/audit-all.sh"
  },
  "keywords": [
    "discord",
    "bot",
    "typescript"
  ],
  "author": "Taka",
  "license": "MIT",
  "dependencies": {
    "@discordjs/voice": "^0.19.2",
    "@snazzah/davey": "^0.1.11",
    "better-sqlite3": "^12.9.0",
    "discord.js": "^14.26.3",
    "dotenv": "^17.4.2",
    "node-cron": "^4.2.1",
    "opusscript": "^0.0.8",
    "prism-media": "^1.3.5",
    "sodium-native": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.6.0",
    "@types/node-cron": "^3.0.11",
    "@vitest/coverage-v8": "^4.1.4",
    "eslint": "^10.2.1",
    "prettier": "^3.8.3",
    "tsx": "^4.6.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.58.2",
    "vitest": "^4.1.4"
  },
  "overrides": {
    "undici": "6.29.0",
    "flatted": "3.4.2",
    "ws": "8.21.2"
  }
}
